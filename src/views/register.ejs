<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ChaiCode Cinema</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
    <style>
      :root {
        --red: #e3000f;
        --red-dim: #8b0009;
        --red-glow: rgba(227, 0, 15, 0.25);
        --black: #050505;
        --surface: #0d0d0d;
        --border: #1a1a1a;
        --text: #f0e6e6;
        --muted: #5a4a4a;
        --mono: 'Share Tech Mono', monospace;
        --serif: 'Noto Serif JP', serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        background: var(--black);
        color: var(--text);
        font-family: var(--serif);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
      }

      .kanji-strip {
        position: fixed;
        top: 0;
        font-family: var(--serif);
        font-size: 1.1rem;
        color: #1a0a0a;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        letter-spacing: 0.4em;
        line-height: 1;
        user-select: none;
        pointer-events: none;
        animation: drift 20s linear infinite;
      }
      .kanji-strip:nth-child(1) { left: 3%; animation-delay: 0s; }
      .kanji-strip:nth-child(2) { left: 8%; animation-delay: -5s; color: #150606; font-size: 0.9rem; }
      .kanji-strip:nth-child(3) { right: 5%; animation-delay: -10s; }
      .kanji-strip:nth-child(4) { right: 12%; animation-delay: -3s; color: #120505; font-size: 0.85rem; }

      @keyframes drift {
        0% { transform: translateY(-100px); }
        100% { transform: translateY(100vh); }
      }

      .scanline {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: var(--red);
        opacity: 0.15;
        animation: scan 8s linear infinite;
        pointer-events: none;
      }
      @keyframes scan {
        0% { top: 0; opacity: 0; }
        10% { opacity: 0.15; }
        90% { opacity: 0.15; }
        100% { top: 100vh; opacity: 0; }
      }

      .corner-seal {
        position: fixed;
        width: 80px; height: 80px;
        border: 1px solid var(--red-dim);
        opacity: 0.3;
        pointer-events: none;
      }
      .corner-seal::before {
        content: '';
        position: absolute;
        inset: 6px;
        border: 1px solid var(--red-dim);
      }
      .corner-seal.tl { top: 20px; left: 20px; border-right: none; border-bottom: none; }
      .corner-seal.tl::before { border-right: none; border-bottom: none; }
      .corner-seal.tr { top: 20px; right: 20px; border-left: none; border-bottom: none; }
      .corner-seal.tr::before { border-left: none; border-bottom: none; }
      .corner-seal.bl { bottom: 20px; left: 20px; border-right: none; border-top: none; }
      .corner-seal.bl::before { border-right: none; border-top: none; }
      .corner-seal.br { bottom: 20px; right: 20px; border-left: none; border-top: none; }
      .corner-seal.br::before { border-left: none; border-top: none; }

      .card {
        position: relative;
        width: 420px;
        background: var(--surface);
        border: 1px solid #220a0a;
        padding: 56px 48px 48px;
        animation: appear 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
      }

      .card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--red), transparent);
      }

      .card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at top center, rgba(227,0,15,0.04) 0%, transparent 60%);
        pointer-events: none;
      }

      @keyframes appear {
        to { opacity: 1; transform: translateY(0); }
      }

      .seal-mark {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 40px;
      }

      .red-seal {
        width: 44px; height: 44px;
        background: var(--red);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
        position: relative;
      }
      .red-seal::after {
        content: '';
        position: absolute;
        inset: -3px;
        border: 1px solid var(--red);
        opacity: 0.3;
      }

      .title-ja {
        font-size: 0.7rem;
        color: var(--red);
        font-family: var(--mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        margin-bottom: 2px;
      }
      .title-en {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: 0.05em;
      }

      .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 32px;
      }
      .divider-line { flex: 1; height: 1px; background: var(--border); }
      .divider-text {
        font-family: var(--mono);
        font-size: 0.65rem;
        color: var(--muted);
        letter-spacing: 0.3em;
      }

      .field {
        margin-bottom: 20px;
        position: relative;
      }

      label {
        display: block;
        font-family: var(--mono);
        font-size: 0.65rem;
        color: var(--red);
        letter-spacing: 0.25em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }

      input {
        width: 100%;
        background: #080808;
        border: 1px solid #1e0808;
        color: var(--text);
        font-family: var(--mono);
        font-size: 0.9rem;
        padding: 13px 16px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
     
      }

      input::placeholder { color: #2a1a1a; }

      input:focus {
        border-color: var(--red-dim);
        box-shadow: 0 0 0 1px var(--red-dim), inset 0 0 20px rgba(227,0,15,0.03);
      }

      .error-box {
        background: rgba(227,0,15,0.06);
        border: 1px solid var(--red-dim);
        border-left: 3px solid var(--red);
        padding: 10px 14px;
        margin-bottom: 20px;
        font-family: var(--mono);
        font-size: 0.75rem;
        color: #ff6666;
        display: none;
      }
      .error-box.show { display: block; }

      .success-box {
        background: rgba(0,180,0,0.06);
        border: 1px solid #0a3a0a;
        border-left: 3px solid #00b400;
        padding: 10px 14px;
        margin-bottom: 20px;
        font-family: var(--mono);
        font-size: 0.75rem;
        color: #66cc66;
        display: none;
      }
      .success-box.show { display: block; }

      .btn-submit {
        width: 100%;
        background: var(--red);
        color: #fff;
        border: none;
        font-family: var(--serif);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        padding: 15px;
        cursor: pointer;
        transition: background 0.2s, box-shadow 0.2s, transform 0.1s;
        margin-top: 8px;
        position: relative;
        overflow: hidden;
      }

      .btn-submit::before {
        content: '';
        position: absolute;
        top: 0; left: -100%;
        width: 100%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        transition: left 0.4s;
      }

      .btn-submit:hover { background: #ff0010; box-shadow: 0 0 30px var(--red-glow); }
      .btn-submit:hover::before { left: 100%; }
      .btn-submit:active { transform: scale(0.99); }
      .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }

      .footer-link {
        text-align: center;
        margin-top: 28px;
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--muted);
        letter-spacing: 0.05em;
      }
      .footer-link a {
        color: var(--red);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
      }
      .footer-link a:hover { border-color: var(--red); }

      @keyframes pulse-red {
        0%, 100% { box-shadow: 0 0 20px var(--red-glow); }
        50% { box-shadow: 0 0 40px rgba(227,0,15,0.4); }
      }
      .btn-submit.loading { animation: pulse-red 1s infinite; }
    </style>
  </head>
  <body>
    <div class="kanji-strip">新規会員登録映画座席予約システム</div>
    <div class="kanji-strip">チャイコードシネマ会員登録管理</div>
    <div class="kanji-strip">座席予約新規登録システム</div>
    <div class="kanji-strip">会員登録映画館入場許可</div>

    <div class="scanline"></div>

    <div class="corner-seal tl"></div>
    <div class="corner-seal tr"></div>
    <div class="corner-seal bl"></div>
    <div class="corner-seal br"></div>

    <div class="card">
      <div class="seal-mark">
        <div class="red-seal">登</div>
        <div class="title-block">
          <div class="title-ja">ChaiCode Cinema</div>
          <div class="title-en">Create Account</div>
        </div>
      </div>

      <div class="divider">
        <div class="divider-line"></div>
        <div class="divider-text">会員登録</div>
        <div class="divider-line"></div>
      </div>

      <div class="error-box" id="errorBox">— <span id="errorMsg"></span></div>
      <div class="success-box" id="successBox"><span id="successMsg"></span></div>

      <div class="field">
        <label>Name</label>
        <input type="text" id="name" placeholder="Your name" autocomplete="name" />
      </div>

      <div class="field">
        <label>Email</label>
        <input type="email" id="email" placeholder="your@email.com" autocomplete="email" />
      </div>

      <div class="field">
        <label>Password</label>
        <input type="password" id="password" placeholder="••••••••" autocomplete="new-password" />
      </div>

      <button class="btn-submit" id="registerBtn" onclick="handleRegister()">
        Register
      </button>

      <div class="footer-link">
        Alreadyt have an account？ &nbsp;
        <a href="/api/auth/login">Login</a>
      </div>
    </div>

    <script>
      async function handleRegister() {
        const name = document.getElementById('name').value.trim();
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        const btn = document.getElementById('registerBtn');
        const errorBox = document.getElementById('errorBox');
        const errorMsg = document.getElementById('errorMsg');
        const successBox = document.getElementById('successBox');
        const successMsg = document.getElementById('successMsg');

        errorBox.classList.remove('show');
        successBox.classList.remove('show');

        if (!name || !email || !password) {
          errorMsg.textContent = 'All fields are required.';
          errorBox.classList.add('show');
          return;
        }

        btn.disabled = true;
        btn.classList.add('loading');
        btn.textContent = '登録中... Registering';

        try {
          const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, password }),
            credentials: 'include'
          });

          const data = await res.json();

          if (!res.ok) {
            errorMsg.textContent = data.message || 'Registration failed.';
            errorBox.classList.add('show');
            btn.disabled = false;
            btn.classList.remove('loading');
            btn.textContent = '登録する — Register';
            return;
          }

          btn.classList.remove('loading');
          btn.textContent = '✓ 登録完了';
          successMsg.textContent = 'Account created. Redirecting to login...';
          successBox.classList.add('show');
          setTimeout(() => { window.location.href = '/api/auth/verify-email-notice'; }, 1500);

        } catch (err) {
          errorMsg.textContent = 'Network error. Try again.';
          errorBox.classList.add('show');
          btn.disabled = false;
          btn.classList.remove('loading');
          btn.textContent = '登録する — Register';
        }
      }

      document.addEventListener('keydown', e => {
        if (e.key === 'Enter') handleRegister();
      });
    </script>
  </body>
</html>
