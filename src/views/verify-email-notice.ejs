<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ChaiCode Cinema</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
    <style>
      :root {
        --red: #e3000f;
        --red-dim: #8b0009;
        --red-glow: rgba(227, 0, 15, 0.25);
        --black: #050505;
        --surface: #0d0d0d;
        --border: #1a1a1a;
        --text: #f0e6e6;
        --muted: #5a4a4a;
        --mono: 'Share Tech Mono', monospace;
        --serif: 'Noto Serif JP', serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        background: var(--black);
        color: var(--text);
        font-family: var(--serif);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
      }

      /* Vertical kanji strips */
      .kanji-strip {
        position: fixed;
        top: 0;
        font-family: var(--serif);
        font-size: 1.1rem;
        color: #1a0a0a;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        letter-spacing: 0.4em;
        line-height: 1;
        user-select: none;
        pointer-events: none;
        animation: drift 20s linear infinite;
      }
      .kanji-strip:nth-child(1) { left: 3%; animation-delay: 0s; color: #1c0808; }
      .kanji-strip:nth-child(2) { left: 8%; animation-delay: -5s; color: #150606; font-size: 0.9rem; }
      .kanji-strip:nth-child(3) { right: 5%; animation-delay: -10s; color: #1c0808; }
      .kanji-strip:nth-child(4) { right: 12%; animation-delay: -3s; color: #120505; font-size: 0.85rem; }
      .kanji-strip:nth-child(5) { left: 18%; animation-delay: -7s; color: #0f0404; font-size: 0.75rem; }
      .kanji-strip:nth-child(6) { right: 22%; animation-delay: -14s; color: #130505; font-size: 0.95rem; }

      @keyframes drift {
        0% { transform: translateY(-100px); }
        100% { transform: translateY(100vh); }
      }

      /* Red horizontal scan line */
      .scanline {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: var(--red);
        opacity: 0.15;
        animation: scan 8s linear infinite;
        pointer-events: none;
      }
      @keyframes scan {
        0% { top: 0; opacity: 0; }
        10% { opacity: 0.15; }
        90% { opacity: 0.15; }
        100% { top: 100vh; opacity: 0; }
      }

      /* Corner seals */
      .corner-seal {
        position: fixed;
        width: 80px; height: 80px;
        border: 1px solid var(--red-dim);
        opacity: 0.3;
        pointer-events: none;
      }
      .corner-seal::before {
        content: '';
        position: absolute;
        inset: 6px;
        border: 1px solid var(--red-dim);
      }
      .corner-seal.tl { top: 20px; left: 20px; border-right: none; border-bottom: none; }
      .corner-seal.tl::before { border-right: none; border-bottom: none; }
      .corner-seal.tr { top: 20px; right: 20px; border-left: none; border-bottom: none; }
      .corner-seal.tr::before { border-left: none; border-bottom: none; }
      .corner-seal.bl { bottom: 20px; left: 20px; border-right: none; border-top: none; }
      .corner-seal.bl::before { border-right: none; border-top: none; }
      .corner-seal.br { bottom: 20px; right: 20px; border-left: none; border-top: none; }
      .corner-seal.br::before { border-left: none; border-top: none; }

      /* Main card */
      .card {
        position: relative;
        width: 420px;
        background: var(--surface);
        border: 1px solid #220a0a;
        padding: 56px 48px 48px;
        animation: appear 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
      }

      .card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--red), transparent);
      }

      .card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at top center, rgba(227,0,15,0.04) 0%, transparent 60%);
        pointer-events: none;
      }

      @keyframes appear {
        to { opacity: 1; transform: translateY(0); }
      }

      /* Header */
      .seal-mark {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 40px;
      }

      .red-seal {
        width: 44px; height: 44px;
        background: var(--red);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
        position: relative;
      }
      .red-seal::after {
        content: '';
        position: absolute;
        inset: -3px;
        border: 1px solid var(--red);
        opacity: 0.3;
      }

  
      .title-ja {
        font-size: 0.7rem;
        color: var(--red);
        font-family: var(--mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        margin-bottom: 2px;
      }
      .title-en {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: 0.05em;
      }

      /* Divider */
      .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 32px;
      }
      .divider-line {
        flex: 1;
        height: 1px;
        background: var(--border);
      }
      .divider-text {
        font-family: var(--mono);
        font-size: 0.65rem;
        color: var(--muted);
        letter-spacing: 0.3em;
      }

      /* Form */
      .field {
        margin-bottom: 20px;
        position: relative;
      }

      label {
        display: block;
        font-family: var(--mono);
        font-size: 0.65rem;
        color: var(--red);
        letter-spacing: 0.25em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }

      input {
        width: 100%;
        background: #080808;
        border: 1px solid #1e0808;
        color: var(--text);
        font-family: var(--mono);
        font-size: 0.9rem;
        padding: 13px 16px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      
      }

      input::placeholder { color: #2a1a1a; }

      input:focus {
        border-color: var(--red-dim);
        box-shadow: 0 0 0 1px var(--red-dim), inset 0 0 20px rgba(227,0,15,0.03);
      }

      /* Error */
      .error-box {
        background: rgba(227,0,15,0.06);
        border: 1px solid var(--red-dim);
        border-left: 3px solid var(--red);
        padding: 10px 14px;
        margin-bottom: 20px;
        font-family: var(--mono);
        font-size: 0.75rem;
        color: #ff6666;
        display: none;
      }
      .error-box.show { display: block; }

      /* Submit */
      .btn-submit {
        width: 100%;
        background: var(--red);
        color: #fff;
        border: none;
        font-family: var(--serif);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        padding: 15px;
        cursor: pointer;
        transition: background 0.2s, box-shadow 0.2s, transform 0.1s;
        margin-top: 8px;
        position: relative;
        overflow: hidden;
      }

      .btn-submit::before {
        content: '';
        position: absolute;
        top: 0; left: -100%;
        width: 100%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        transition: left 0.4s;
      }

      .btn-submit:hover {
        background: #ff0010;
        box-shadow: 0 0 30px var(--red-glow);
      }
      .btn-submit:hover::before { left: 100%; }
      .btn-submit:active { transform: scale(0.99); }
      .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }

      /* Footer link */
      .footer-link {
        text-align: center;
        margin-top: 28px;
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--muted);
        letter-spacing: 0.05em;
      }
      .footer-link a {
        color: var(--red);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
      }
      .footer-link a:hover { border-color: var(--red); }

      /* Loading state */
      @keyframes pulse-red {
        0%, 100% { box-shadow: 0 0 20px var(--red-glow); }
        50% { box-shadow: 0 0 40px rgba(227,0,15,0.4); }
      }
      .btn-submit.loading { animation: pulse-red 1s infinite; }
    </style>
  </head>
  <body>
    <!-- Kanji atmosphere -->
    <div class="kanji-strip">映画座席予約システム認証入場許可証明書</div>
    <div class="kanji-strip">チャイコードシネマ入場管理システム</div>
    <div class="kanji-strip">座席予約認証システム許可証明</div>
    <div class="kanji-strip">入場映画館座席管理予約</div>
    <div class="kanji-strip">認証システム許可証入場</div>
    <div class="kanji-strip">映画予約座席認証管理</div>

    <div class="scanline"></div>

    <!-- Corner decorations -->
    <div class="corner-seal tl"></div>
    <div class="corner-seal tr"></div>
    <div class="corner-seal bl"></div>
    <div class="corner-seal br"></div>

    <div class="card">
      <div class="seal-mark">
        <div class="red-seal">映</div>
        <div class="title-block">
          <div class="title-ja">ChaiCode Cinema</div>
          <div class="title-en">Member Login</div>
        </div>
      </div>

      <div class="title-en">Verify Your Email</div>

<div class="divider">
  <div class="divider-line"></div>
  <div class="divider-text">確認メール送信済み</div>
  <div class="divider-line"></div>
</div>

<div class="success-box show">
  📩 We’ve sent a verification link to your email.<br><br>
  Click the link to activate your account.
</div>

<div class="footer-link">
  <a href="/api/auth/login">Back to Login</a>
</div>

    <script>
      async function handleLogin() {
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        const btn = document.getElementById('loginBtn');
        const errorBox = document.getElementById('errorBox');
        const errorMsg = document.getElementById('errorMsg');

        errorBox.classList.remove('show');

        if (!email || !password) {
          errorMsg.textContent = 'All fields are required.';
          errorBox.classList.add('show');
          return;
        }

        btn.disabled = true;
        btn.classList.add('loading');
        btn.textContent = '認証中... Authenticating';

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
            credentials: 'include'
          });

          const data = await res.json();

          if (!res.ok) {
            errorMsg.textContent = data.message || 'Invalid credentials.';
            errorBox.classList.add('show');
            btn.disabled = false;
            btn.classList.remove('loading');
            btn.textContent = '入場する — Enter';
            return;
          }

          btn.textContent = '✓ 認証完了';
          setTimeout(() => { window.location.href = '/'; }, 500);

        } catch (err) {
          errorMsg.textContent = 'Network error. Try again.';
          errorBox.classList.add('show');
          btn.disabled = false;
          btn.classList.remove('loading');
          btn.textContent = '入場する — Enter';
        }
      }

      document.addEventListener('keydown', e => {
        if (e.key === 'Enter') handleLogin();
      });
    </script>
  </body>
</html>
